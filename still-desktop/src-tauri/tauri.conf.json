{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Still",
  "version": "0.20.0",
  "identifier": "nz.personal.still",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:4318/design-preview.html",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Still \u00b7 ver0.20",
        "url": "design-preview.html",
        "width": 1360,
        "height": 960,
        "minWidth": 780,
        "minHeight": 660,
        "transparent": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; frame-src https://www.desmos.com"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
