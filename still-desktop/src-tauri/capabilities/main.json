{
  "identifier":"main",
  "description":"Only the local workspace UI can control embedded browsers, open Chrome, capture widgets and access selected files.",
  "webviews":["main"],
  "permissions":[
    "allow-assistant-configured", "allow-assistant-models", "allow-assistant-set-key", "allow-assistant-chat", "allow-assistant-key-setup",
    "core:event:allow-listen", "core:event:allow-unlisten",
    "core:window:allow-is-fullscreen", "core:window:allow-set-fullscreen",
    "allow-chrome-open", "allow-widget-capture", "allow-widget-export",
    "allow-files-choose", "allow-files-list", "allow-files-open", "allow-files-reuse", "allow-files-preview", "allow-document-open", "allow-document-choose", "allow-document-preview",
    "allow-app-open", "allow-app-choose", "allow-app-panel-open", "allow-app-panel-windows", "allow-app-panel-identity", "allow-app-panel-attach", "allow-app-panel-present", "allow-app-panel-release", "allow-app-panel-suspend", "allow-app-panel-resume", "allow-app-panel-configure-shutdown",
    "allow-app-picker-windows", "allow-app-picker-prepare", "allow-app-picker-preview", "allow-app-picker-installed", "allow-app-picker-select-installed", "allow-app-capture-enable", "allow-shortcuts-configure",
    "allow-window-input-update-regions", "allow-window-input-configure-toggle", "allow-window-input-set-click-through",
    "allow-startup-status", "allow-startup-set"
  ]
}
